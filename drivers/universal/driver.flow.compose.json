{
  "triggers": [
    {
      "id": "button_triggered",
      "title": {
        "en": "Button pressed",
        "de": "Taste gedrückt"
      },
      "titleFormatted": {
        "en": "Button [[name]] was pressed",
        "de": "Taste [[name]] wurde gedrückt"
      },
      "$filter": "capabilities=button.0",
      "args": [
        {
          "type": "autocomplete",
          "name": "name",
          "placeholder": {
            "en": "Button: top left",
            "de": "Taste: oben links"
          }
        }
      ]
    },
    {
      "id": "button_single_triggered",
      "title": {
        "en": "Button pressed",
        "de": "Taste gedrückt"
      },
      "titleFormatted": {
        "en": "Button was pressed",
        "de": "Taste wurde gedrückt"
      },
      "$filter": "capabilities=button.single"
    }
  ],
  "conditions": [
    {
      "id": "temperature_is",
      "title": {
        "en": "Temperature is !{{equal to or above|below}}",
        "de": "Temperatur ist !{{gleich oder über|unter}}"
      },
      "titleFormatted": {
        "en": "Temperature is !{{equal to or above|below}} [[temperature]] °C",
        "de": "Temperatur ist !{{gleich oder über|unter}} [[temperature]] °C"
      },
      "$filter": "capabilities=measure_temperature",
      "args": [
        {
          "name": "temperature",
          "type": "number",
          "placeholder": {
            "en": "temperature",
            "de": "Temperatur"
          },
          "min": 5,
          "max": 40,
          "step": 0.5
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "blind_open",
      "title": {
        "en": "Open blind",
		"de": "Rollladen öffnen"
      },
	  "$filter": "capabilities=blind_mode"
    },
	{
	  "id": "blind_close",
	  "title": {
		"en": "Close blind",
		"de": "Rollladen schließen"
	  },
	  "$filter": "capabilities=blind_mode"
	},
	{
	  "id": "blind_stop",
	  "title": {
		"en": "Stop blind",
		"de": "Rollladen stoppen"
	  },
	  "$filter": "capabilities=blind_mode"
	}
  ]
}
