{
  "id": "network_device_disconnected",
  "title": {
    "en": "Network device has disconnected",
    "de": "Netzwerkgerät hat sich getrennt"
  },
  "tokens": [
	{
	  "name": "device_name",
	  "type": "string",
	  "title": {
		"en": "Device name",
		"de": "Gerätename"
	  },
	  "example": {
		"en": "Max-phone",
		"de": "Max-phone"
	  }
	},
	{
	  "name": "device_ip",
	  "type": "string",
	  "title": {
		"en": "Device IP address",
		"de": "IP-Adresse des Geräts"
	  },
	  "example": {
		"en": "192.168.178.25",
		"de": "192.168.178.25"
	  }
	},
	{
	  "name": "device_mac",
	  "type": "string",
	  "title": {
		"en": "Device MAC address",
		"de": "MAC-Adresse des Geräts"
	  },
	  "example": {
		"en": "00:1B:44:11:3A:B7",
		"de": "00:1B:44:11:3A:B7"
	  }
	},
	{
	  "name": "device_connection_type",
	  "type": "string",
	  "title": {
		"en": "Device connection type",
		"de": "Verbindungsart des Geräts"
	  },
	  "example": {
		"en": "ethernet or wlan",
		"de": "ethernet oder wlan"
	  }
	}
  ]
}
