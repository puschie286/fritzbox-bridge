{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "rootDir": ".",
    "outDir": ".homeybuild/",
    "sourceMap": true,
    "lib": [
      "es2024"
    ],
    "noImplicitOverride": true,
    "types": [
      "node",
      "homey"
    ],
    "moduleDetection": "legacy"
  },
  "include": [
    "app.ts",
    "api.ts",
    "drivers/**/*.ts",
    "features/**/*.ts",
    "lib/**/*.ts",
    "types/**/*.ts",
    "types/**/*.js"
  ],
  "exclude": [
    "node_modules",
    ".homeybuild"
  ]
}
