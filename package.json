{
  "name": "com.puschie.fritzbox-bridge",
  "version": "0.12.2",
  "description": "Fritzbox Bridge",
  "main": "app.js",
  "dependencies": {
    "sax": "^1.6.1"
  },
  "devDependencies": {
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/node": "^22.0.0",
    "@types/sax": "^1.2.7",
    "eslint": "^8.57.1",
    "eslint-config-athom": "^4.0.2",
    "homey": "^4.6.0",
    "typescript": "^5.9.3"
  },
  "author": "Puschie",
  "scripts": {
    "run": "homey app run",
    "publish": "homey app publish",
    "build": "tsc",
    "lint": "eslint --ext .js,.ts --ignore-path .gitignore .",
