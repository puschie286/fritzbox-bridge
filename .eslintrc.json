{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:homey-app/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "env": {
    "node": true,
    "es2021": true
  },
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/ban-ts-comment": "off",
    "@typescript-eslint/no-require-imports": "off",
    "@typescript-eslint/no-empty-object-type": [
      "error",
      {
        "allowObjectTypes": "always"
      }
    ],
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "args": "none",
        "caughtErrors": "none",
        "ignoreRestSiblings": true,
        "destructuredArrayIgnorePattern": "^_"
      }
    ],
    "prefer-const": "off",
    "no-extra-semi": "off",
    "no-mixed-spaces-and-tabs": "off"
  },
  "overrides": [
    {
      "files": [
        "**/*.ts"
      ],
      "rules": {
        "no-undef": "off"
      }
    },
    {
      "files": [
        "settings/**/*.js"
      ],
      "env": {
        "node": false,
        "browser": true
      },
      "rules": {
        "homey-app/global-timers": "off",
        "@typescript-eslint/no-unused-vars": [
          "warn",
          {
            "vars": "local",
            "caughtErrors": "none",
            "args": "none"
          }
        ]
      },
      "parserOptions": {
        "sourceType": "script"
      }
    },
    {
      "files": [
        "types/ParingDevice.ts"
      ],
      "parserOptions": {
        "sourceType": "script"
      },
      "rules": {
        "@typescript-eslint/no-unused-vars": [
          "warn",
          {
            "args": "none",
            "vars": "local",
            "varsIgnorePattern": "^ParingDevice$"
          }
        ]
      }
    }
  ]
}
